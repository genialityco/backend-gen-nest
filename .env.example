# Copia este archivo como .env y completa los valores. Nunca subas valores reales aquí.

MONGO_URI=
PORT=3000

# Firebase Admin (cuenta de servicio)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=
authDomain=
storageBucket=
messagingSenderId=
appId=
measurementId=

# Correo (AWS SES, mismas claves que GenCampus / geniality-renewed-backend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Debe ser un correo o dominio verificado en SES
AWS_SES_EMAIL_FROM=certificate@acho.geniality.com.co
AWS_SES_EMAIL_FROM_NAME=ACHO
# Pausa en milisegundos entre los envíos de un lote.
EMAIL_BULK_DELAY_MS=300
# Contraseña privada del panel de certificados. Usa un valor largo y aleatorio.
CERTIFICATE_ADMIN_PASSWORD=
# Landing de descarga por defecto (el admin la puede cambiar por evento)
CERTIFICATES_APP_URL=https://gen-certificados.netlify.app
